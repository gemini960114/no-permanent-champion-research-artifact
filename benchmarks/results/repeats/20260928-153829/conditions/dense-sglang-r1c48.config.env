# ==============================================================================
# SGLang Qwen3.8-27B 服務設定檔 (config.env)
# ==============================================================================

# 1. SLURM 叢集資源設定 (1 Core H200 GPU)
SLURM_ACCOUNT=<account>
SLURM_PARTITION=8gpus          # 或可選 dev (測試分區)
SLURM_GPUS=1                  # 1 Core H200 GPU
SLURM_CPUS=12                 # 搭配 12 CPU Cores
SLURM_MEM=120G                # 搭配 120GB 記憶體
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
# 官方 Cookbook (docs.sglang.io Qwen3.8-27B) 建議最新框架版本 → 0.5.20
SIF_PATH=<containers>/sglang_0.5.20.sif
MODELS_DIR=<models>
HF_CACHE_DIR=<hf-cache>

# HuggingFace 授權 Token
HF_TOKEN=<redacted>

# 3. 模型名稱與路徑
MODEL_NAME=Qwen/Qwen3.8-27B-FP8
FALLBACK_MODEL_NAME=Qwen/Qwen3.8-27B

# 4. SGLang 服務參數
PORT=30000
HOST=0.0.0.0
KV_CACHE_DTYPE=fp8_e4m3
MEM_FRACTION=0.85
ATTENTION_BACKEND=flashinfer
CHUNKED_PREFILL_SIZE=32768
MAX_PREFILL_TOKENS=32768
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder

# 官方 Cookbook 對 H200 單卡只發佈一組基準參數（上述 7 項），不含任何 MAMBA 調校；
# 舊配置的 MAMBA_FULL_MEMORY_RATIO=4.59 等三參數查無官方出處，已移除回歸基準。
# 但官方預設 ratio=0.9 會把併發壓到 44（mamba 220 slots ÷ 5/req），
# 500 人工作量下大量排隊。依官方文件兩槓桿設定目標併發 128：
#   --max-mamba-cache-size = 128 × 5 slots = 640（官方公式：target_concurrency × S）
#   --mamba-ssm-dtype bfloat16（官方建議之狀態減半槓桿，45GB 可容納 640 slots）
# R2 賽制：EAGLE 投機解碼載入 draft 權重後，cap 128 + 640 slots 超出 0.85 記憶體預算
# （vLLM MTP 與主模型共享權重無此限制——框架實作差異）。採硬體可行的 cap 48 + 240 slots
MAMBA_SSM_DTYPE=bfloat16

# 投機解碼（官方 EAGLE 3/1/4，使用 checkpoint 內建 MTP head）——R2 壓測時取消註解

# 5. SGLang 內部 API 鑑權保護
SGLANG_API_KEY=<redacted>


# 健康自檢逾時 (秒)：超過仍未就緒將自動 scancel 釋放 GPU
HEALTH_TIMEOUT=600

# ---- run_ab_repeats.sh 覆寫（run 20260928-153829，條件 dense-sglang-r1c48）----
MODEL_ALIAS=abrep-dense-sglang
ALIAS_CLAIM=isolated
MAX_RUNNING_REQUESTS=48
MAX_MAMBA_CACHE_SIZE=240
