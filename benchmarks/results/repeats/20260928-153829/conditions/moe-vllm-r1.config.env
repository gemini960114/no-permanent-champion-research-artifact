# ==============================================================================
# vLLM Qwen3.8-Flash-Next 服務設定檔 (config.env)
# 參數依官方 vLLM Recipe (recipes.vllm.ai/Qwen/Qwen3.8-Flash-Next) 8x H200 章節
# 之 TEP4 調整版（4x H200；權重與 sglang-qwen-flash 共享本地 FP8，零下載）。
# 用途：SGLang vs vLLM 同模型 A/B 對決（同權重、同 4x H200、同併發上限）。
# ==============================================================================

# 1. SLURM 叢集資源設定 (4x H200 GPU, TEP4 —— 與 sglang-qwen-flash 對等)
SLURM_ACCOUNT=<account>
SLURM_PARTITION=8gpus
SLURM_GPUS=4
SLURM_CPUS=48
SLURM_MEM=240G
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
SIF_PATH=<containers>/vllm_0.29.1rc1.sif
MODELS_DIR=<models>
HF_CACHE_DIR=<hf-cache>

# HuggingFace 授權 Token
HF_TOKEN=<redacted>

# 3. 模型名稱與路徑（-vLLM 後綴：Gateway 命名空間與 SGLang flash 隔離）
MODEL_NAME=Qwen/Qwen3.8-Flash-Next-vLLM
FALLBACK_MODEL_NAME=Qwen/Qwen3.8-Flash-Next-FP8
# 生產切換開關：production＝取得生產別名組（qwen3.8-flash 等）；isolated＝只留後綴別名

# 4. vLLM 服務參數（官方 Recipe：TEP + triton MoE；純 TP 與 FP8 128-寬量化塊不相容）
PORT=37000
HOST=0.0.0.0
TENSOR_PARALLEL_SIZE=4
ENABLE_EXPERT_PARALLEL=true
MOE_BACKEND=triton
GPU_MEMORY_UTILIZATION=0.85
ENABLE_PREFIX_CACHING=true
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder

# 投機解碼（官方 MTP；Recipe 於 H100 實測變慢、acceptance ~36%——R2 壓測驗證用）

# 5. API 內部鑑權金鑰保護（獨立變數名，避免與 vllm-qwen27b 的 VLLM_API_KEY 撞名）
VLLM_FLASH_API_KEY=<redacted>
API_KEY_ENV=VLLM_FLASH_API_KEY

# 健康自檢逾時 (秒)：173GB 權重載入＋編譯較久
HEALTH_TIMEOUT=2400

# ---- run_ab_repeats.sh 覆寫（run 20260928-153829，條件 moe-vllm-r1）----
MODEL_ALIAS=abrep-moe-vllm
ALIAS_CLAIM=isolated
MAX_NUM_SEQS=256
