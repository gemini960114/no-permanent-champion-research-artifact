# ==============================================================================
# SGLang Qwen3.8-Flash-Next 服務設定檔 (config.env)
# ==============================================================================

# 1. SLURM 叢集資源設定 (4x H200 GPU, TP=4, EP=4)
SLURM_ACCOUNT=<account>
SLURM_PARTITION=8gpus          # 或可選 dev (測試分區)
SLURM_GPUS=8
SLURM_CPUS=96
SLURM_MEM=480G
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
SIF_PATH=<containers>/sglang_0.5.20.sif
CONTAINER_IMAGE=docker://lmsysorg/sglang:latest
MODELS_DIR=<models>
HF_CACHE_DIR=<hf-cache>

# HuggingFace 授權 Token
HF_TOKEN=<redacted>

# 3. 模型名稱與路徑
MODEL_NAME=zai-org/GLM-5.3-Flash

# 4. SGLang 服務與高階推論參數
PORT=35000
HOST=0.0.0.0
TP=8
EP=8
MEM_FRACTION=0.75
KV_CACHE_DTYPE=bfloat16
DSA_PREFILL_BACKEND=tilelang
DSA_DECODE_BACKEND=tilelang
MOE_RUNNER_BACKEND=deep_gemm
CHUNKED_PREFILL_SIZE=8192
# 生產定案（2026-09-27 A/B 第三戰）：MTP 實測 -15%（3,135 vs 3,669 tok/s），關閉為最佳配置
REASONING_PARSER=auto
TOOL_CALL_PARSER=auto

# 5. SGLang 內部 API 鑑權保護
SGLANG_API_KEY=<redacted>
API_KEY_ENV=SGLANG_API_KEY

# 健康自檢逾時 (秒)：超過仍未就緒將自動 scancel 釋放 GPU
HEALTH_TIMEOUT=2400

# 併發解碼上限 (覆蓋投機解碼的自動 48 上限；記憶體充足下可提高總吞吐)

# ---- run_ab_repeats.sh 覆寫（run 20260928-153829，條件 kda-sglang-r2）----
MODEL_ALIAS=abrep-kda-sglang
ALIAS_CLAIM=isolated
MAX_RUNNING_REQUESTS=128
SPECULATIVE_ALGORITHM=EAGLE
SPECULATIVE_NUM_STEPS=5
SPECULATIVE_EAGLE_TOPK=1
SPECULATIVE_NUM_DRAFT_TOKENS=6
