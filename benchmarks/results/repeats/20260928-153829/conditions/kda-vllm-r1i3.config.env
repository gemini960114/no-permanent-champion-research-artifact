# ==============================================================================
# vLLM GLM-5.3-Flash 服務設定檔 (config.env)
# 參數依官方 vLLM Recipe (recipes.vllm.ai/zai-org/GLM-5.3-Flash)；
# 權重與 sglang-glm53-flash 共享本地 FP8（306GB，零下載）。
# 用途：SGLang vs vLLM A/B 第三戰（同權重、同 8x H200、同併發上限）。
# ==============================================================================

# 1. SLURM 叢集資源設定 (8x H200 GPU, TEP8 —— 與 sglang-glm53-flash 對等)
SLURM_ACCOUNT=<account>
SLURM_PARTITION=8gpus
SLURM_GPUS=8
SLURM_CPUS=96
SLURM_MEM=480G
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
SIF_PATH=<containers>/vllm_glm53-flash.sif
MODELS_DIR=<models>
HF_CACHE_DIR=<hf-cache>

# HuggingFace 授權 Token
HF_TOKEN=<redacted>

# 3. 模型名稱與路徑（-vLLM 後綴：Gateway 命名空間與 SGLang glm53 隔離）
MODEL_NAME=zai-org/GLM-5.3-Flash-vLLM
FALLBACK_MODEL_NAME=zai-org/GLM-5.3-Flash

# 4. vLLM 服務參數（官方 Recipe；⚠️ Hopper 不支援此模型 FP8 KV → 不設 kv-cache-dtype，用 BF16 KV）
PORT=38000
HOST=0.0.0.0
TENSOR_PARALLEL_SIZE=8
ENABLE_EXPERT_PARALLEL=true
REASONING_PARSER=glm47
TOOL_CALL_PARSER=glm47

# 投機解碼（官方 MTP5；R2 壓測時取消註解）

# 5. API 內部鑑權金鑰保護（獨立變數名，避免與其他 vLLM 引擎撞名）
VLLM_GLM_API_KEY=<redacted>
API_KEY_ENV=VLLM_GLM_API_KEY

# 健康自檢逾時 (秒)：306GB 權重載入＋編譯較久
HEALTH_TIMEOUT=2400

# DeepGEMM 繞道（Hopper FP8 GEMM cubin 斷言失敗的解法；改走 CUTLASS）
#VLLM_USE_DEEP_GEMM=0（專用 image 已預編譯 kernel，停用繞道讓優化路徑生效）

# vLLM JIT 快取落地（修容器內 HOME 唯讀導致 deep_gemm cubin 寫不進快取的斷言）
VLLM_CACHE_DIR=<cache>/vllm-glm53

# 關閉 FlashInfer autotune（H200 上曾掛死 31 分鐘；Flash-Next Recipe 同款處理）
ENABLE_FLASHINFER_AUTOTUNE=false

# ---- run_ab_repeats.sh 覆寫（run 20260928-153829，條件 kda-vllm-r1i3）----
MODEL_ALIAS=abrep-kda-vllm
ALIAS_CLAIM=isolated
MAX_NUM_SEQS=128
