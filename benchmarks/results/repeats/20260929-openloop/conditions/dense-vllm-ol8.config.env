# ==============================================================================
# vLLM Qwen3.8-27B 服務設定檔 (config.env)
# 參數依官方 vLLM Recipe (recipes.vllm.ai/Qwen/Qwen3.8-27B) 設定；
# 權重與 sglang-qwen-27b 共享本地 BF16（<models>/Qwen3.8-27B），零下載。
# 用途：SGLang vs vLLM 同模型 A/B 對決（同權重、同 1x H200、同併發上限 128）。
# ==============================================================================

# 1. SLURM 叢集資源設定 (1x H200 GPU, TP=1 —— 與 sglang-qwen-27b 對等)
SLURM_ACCOUNT=<account>
SLURM_PARTITION=8gpus
SLURM_GPUS=1
SLURM_CPUS=12
SLURM_MEM=120G
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
SIF_PATH=<containers>/vllm_0.29.1rc1.sif
MODELS_DIR=<models>
HF_CACHE_DIR=<hf-cache>

# HuggingFace 授權 Token
HF_TOKEN=<redacted>

# 3. 模型名稱與路徑
# MODEL_NAME 带 -vLLM 後綴：Gateway 路由命名空間與 SGLang 27B 隔離（A/B 不混流）
MODEL_NAME=Qwen/Qwen3.8-27B-vLLM
FALLBACK_MODEL_NAME=Qwen/Qwen3.8-27B

# 4. vLLM 服務參數（官方 Recipe：kv fp8 + qwen3 parser「實務上不可省」+ qwen3_xml tool parser）
PORT=36000
HOST=0.0.0.0
TENSOR_PARALLEL_SIZE=1
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=262144
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml

# 投機解碼（官方 MTP：內建 draft head，R2 壓測時取消註解）

# 5. API 內部鑑權金鑰保護
VLLM_API_KEY=<redacted>
API_KEY_ENV=VLLM_API_KEY

# 健康自檢逾時 (秒)：超過仍未就緒將自動 scancel 釋放 GPU
HEALTH_TIMEOUT=1800

# ---- run_ab_repeats.sh 覆寫（run 20260929-openloop，條件 dense-vllm-ol8）----
MODEL_ALIAS=abrep-dense-vllm
ALIAS_CLAIM=isolated
MAX_NUM_SEQS=128
