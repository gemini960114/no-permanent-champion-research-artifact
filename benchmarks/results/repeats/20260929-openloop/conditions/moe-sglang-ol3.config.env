# ==============================================================================
# SGLang Qwen3.8-Flash-Next 服務設定檔 (config.env)
# ==============================================================================

# 1. SLURM 叢集資源設定 (4x H200 GPU, TP=4, EP=4)
SLURM_ACCOUNT=<account>
SLURM_PARTITION=8gpus          # 或可選 dev (測試分區)
SLURM_GPUS=4                  # 4x H200 GPU
SLURM_CPUS=48                 # 搭配 48 CPU Cores
SLURM_MEM=240G                # 搭配 240GB 記憶體
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
SIF_PATH=<containers>/sglang_0.5.20.sif
CONTAINER_IMAGE=docker://lmsysorg/sglang:qwen38flashnext
MODELS_DIR=<models>
HF_CACHE_DIR=<hf-cache>

# HuggingFace 授權 Token
HF_TOKEN=<redacted>

# 3. 模型名稱與路徑
MODEL_NAME=Qwen/Qwen3.8-Flash-Next-FP8
FALLBACK_MODEL_NAME=Qwen/Qwen3.8-Flash-Next
# 生產切換開關：退居熱備援（不搶生產正名；切回＝與 vllm-flash-next 對調 ALIAS_CLAIM 與別名）

# 4. SGLang 服務與高階推論參數
PORT=32000
HOST=0.0.0.0
TP=4
EP=4
MEM_FRACTION=0.85
CHUNKED_PREFILL_SIZE=8192
LINEAR_ATTN_PREFILL_BACKEND=flashinfer
LINEAR_ATTN_DECODE_BACKEND=flashinfer
LINEAR_ATTN_VERIFY_BACKEND=triton
MAMBA_SSM_DTYPE=bfloat16
# PLE 留 GPU（A/B 公平性：vLLM 於 H200 將 51B N-gram embedding 放 GPU）
# 投機解碼（NEXTN 3/1/4＝生產/R2 配置；A/B R1 陽春版註解關閉）
REASONING_PARSER=auto

# 5. SGLang 內部 API 鑑權保護
SGLANG_API_KEY=<redacted>
API_KEY_ENV=SGLANG_API_KEY

# 健康自檢逾時 (秒)：超過仍未就緒將自動 scancel 釋放 GPU
HEALTH_TIMEOUT=1800

# 併發解碼上限 (覆蓋投機解碼的自動 48 上限；記憶體充足下可提高總吞吐)
# R1 賽制：與 vLLM flash 對稱（recipe 規定 max-num-seqs 256）；R2/生產恢復 100

# ---- run_ab_repeats.sh 覆寫（run 20260929-openloop，條件 moe-sglang-ol3）----
MODEL_ALIAS=abrep-moe-sglang
ALIAS_CLAIM=isolated
MAX_RUNNING_REQUESTS=256
PLE_OFFLOAD_EMBEDDING=false
